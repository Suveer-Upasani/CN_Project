# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs and Output (Keep directory structure but ignore generated scans)
logs/*.log
output/*.txt
output/*.json
!output/.gitkeep
!logs/.gitkeep

# Data & SQLite
data/*.db
data/*.sqlite
!data/.gitkeep
instance/

